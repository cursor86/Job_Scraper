{
  "_README": "ONE config file drives the whole tracker (scraper + dashboard). Matching is case-insensitive substring on the JOB TITLE unless noted. Tailored for Melbourne / Australia AI, automation and business-analysis roles (junior and internship level).",

  "profile": {
    "title": "AI & Automation Job Tracker",
    "subtitle": "Melbourne · Victoria · Australia · Remote AU",
    "emoji": "🤖"
  },

  "keywords": {
    "_comment": "A job TITLE is kept if it contains any of these.",
    "include": [
      "ai builder", "ai engineer", "ai developer", "ai automation", "ai agent", "ai workflow", "ai operations",
      "ai specialist", "ai analyst", "ai intern", "llm", "generative ai", "machine learning", "prompt engineer",
      "automation", "automation engineer", "automation specialist", "automation analyst", "automation intern",
      "workflow", "process automation", "rpa", "integration specialist", "integrations",
      "business analyst", "business analysis", "business systems", "systems analyst", "process analyst",
      "data analyst", "data analysis", "business intelligence", "power bi", "technology intern",
      "no-code", "low-code", "developer", "junior developer", "software intern", "product analyst"
    ],
    "_exclude_comment": "Titles containing any of these are dropped.",
    "exclude": [
      "senior", "principal", "staff engineer", "director", "head of", "vice president", "chief ",
      "clearance required", "security clearance", "pharmaceutical", "biotech", "toxicolog"
    ],
    "_fuzzy_comment": "Leave empty to use keyword-only matching.",
    "fuzzy_seniority": [],
    "fuzzy_domain": [],
    "fuzzy_exclude": []
  },

  "search_terms": {
    "_comment": "Queries sent to the job boards' search boxes.",
    "linkedin": [
      "AI builder", "AI automation", "AI agent developer", "junior AI engineer", "automation specialist",
      "workflow automation", "business analyst intern", "business analyst", "business systems analyst",
      "process automation", "AI operations", "data analyst intern", "AI intern"
    ],
    "indeed": [
      "AI automation", "AI builder", "automation specialist", "workflow automation",
      "business analyst intern", "business analyst", "AI intern", "no-code automation"
    ],
    "glassdoor": [
      "AI automation", "automation specialist", "business analyst", "AI intern"
    ],
    "ziprecruiter": [],
    "google_jobs": [
      "AI automation", "AI builder", "automation specialist", "business analyst intern", "AI intern"
    ],
    "hiring_cafe": [],
    "calcareers": [],
    "usajobs": [],
    "governmentjobs": [],
    "workday": []
  },

  "locations": {
    "_comment": "LinkedIn geoId for Australia; JobSpy boards use location + country.",
    "linkedin": [
      { "name": "Melbourne", "location": "Melbourne, Victoria, Australia", "geoId": "" },
      { "name": "Australia (remote)", "location": "Australia", "geoId": "101452733" }
    ],
    "indeed": [
      { "location": "Melbourne, VIC", "country": "Australia" },
      { "location": "Remote", "country": "Australia" }
    ],
    "glassdoor": [
      { "location": "Melbourne, VIC", "country": "Australia" }
    ],
    "ziprecruiter": [],
    "google_jobs": [
      { "location": "Melbourne, VIC", "country": "Australia" }
    ],
    "hiring_cafe": [],
    "_linkedin_partitions_comment": "Leave empty to use single-run backfill.",
    "linkedin_partitions": {
      "states": [],
      "high_volume": {
        "locations": [],
        "day_slices": false
      }
    }
  },

  "location_filter": {
    "_comment": "Case-insensitive substrings matched against a job's location text.",
    "terms": [
      "melbourne", "victoria", ", vic", "remote", "hybrid", "australia",
      "sydney", "brisbane", "canberra", "adelaide", "perth", "new south wales", "queensland"
    ]
  },

  "google_jobs": {
    "_comment": "Optional exact Google Jobs queries. Leave empty to auto-build.",
    "queries": [],
    "serpapi_api_key": "",
    "oxylabs_username": "",
    "oxylabs_password": ""
  },

  "jobspy": {
    "_comment": "Optional. Prefer JOBSPY_PROXIES as a GitHub Actions secret if boards block.",
    "proxies": [],
    "user_agent": ""
  },

  "hiring_cafe": {
    "_comment": "Disabled for this tracker.",
    "max_pages": 3
  },

  "employers": {
    "_priority_comment": "Companies worth a priority digest even on a quiet day.",
    "priority": [
      "Cenitex", "ANZ", "AustralianSuper", "Macquarie", "NAB", "Deakin", "Atlassian", "Canva",
      "Xero", "Employment Hero", "Airwallex", "Culture Amp", "Afterpay", "Telstra", "Commonwealth Bank"
    ],
    "_exclude_comment": "Drop roles from these companies even if the title matches.",
    "exclude": []
  },

  "priority_topics": {
    "_comment": "Roles touching these get a gold star and a 'Priority topics' filter.",
    "terms": [
      ["AI agents", "\\bagents?\\b|agentic"],
      ["Make / n8n / Zapier", "\\bmake\\.com\\b|\\bmake\\b scenario|\\bn8n\\b|\\bzapier\\b"],
      ["Python automation", "\\bpython\\b"],
      ["Finance systems", "xero|myob|quickbooks|netsuite|oracle|sap|erp"]
    ]
  },

  "role_categories": {
    "_comment": "Dashboard 'Role' filter buckets, applied top-to-bottom.",
    "terms": [
      ["AI & Agents", "\\bai\\b|\\bllm\\b|agent|machine learning|generative"],
      ["Automation", "automation|workflow|integration|\\brpa\\b|no-code|low-code"],
      ["Business Analysis", "business analyst|business analysis|business systems|process analyst|systems analyst"],
      ["Data", "data analy|business intelligence|power bi"],
      ["Software", "developer|software|engineer"]
    ]
  },

  "notify": {
    "_comment": "Pushover phone alerts (optional; needs PUSHOVER_TOKEN/USER secrets).",
    "min_fit": 75,
    "weekly_digest": {
      "_comment": "Optional weekly brief.",
      "enabled": false,
      "days": 7
    }
  }
}
